# Copy this file to .env and fill in your values
# cp .env.example .env

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Frontend origin (update if you change the Vite port)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── LLM ─────────────────────────────────────────────────────────────────────
# 'ollama' runs locally (no key needed).
# Switch to 'openai', 'mistral', or 'deepseek' for cloud fallback.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2:1.5b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MAX_TOKENS=800
LLM_TIMEOUT=60

# ── OpenAI (DALL-E 3 image generation + TTS for video pipeline) ──────────────
OPENAI_API_KEY=

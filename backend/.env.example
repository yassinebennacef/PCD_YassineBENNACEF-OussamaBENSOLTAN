SECRET_KEY=learnly-local-dev-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Frontend origin (update if you change the Vite port)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# LLM — 'ollama' runs locally (no key needed).
# Switch to 'openai', 'mistral', or 'deepseek' for cloud fallback.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2:1.5b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MAX_TOKENS=800
LLM_TIMEOUT=60

# Only needed for AI video generation (DALL-E 3 + TTS)
OPENAI_API_KEY=
